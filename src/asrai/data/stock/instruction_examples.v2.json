  "examples": [
    {
      "$schema": "instruction.v2.schema.json",
      "schema_version": "2.0.0",
      "id": "example.body_width",
      "status": "proposed",
      "axis": "direction_compliance",
      "intent": "Increase only the horizontal proportion of the drone body by 20% relative to the reference state.",
      "target": {
        "asset_ref": "example://assets/drone-study",
        "selector": "Drone/Body",
        "selector_language": "illustrative_scene_path"
      },
      "context": {
        "baseline_ref": "example://snapshots/drone-r0",
        "baseline_values": {
          "scale_x": 1.0
        },
        "space": "object",
        "axis": "local_x",
        "origin": "object_origin",
        "parent_transform": "preserved",
        "unit_scale": "unchanged"
      },
      "changes": [
        {
          "term_id": "space.scale",
          "operation": "relative_delta",
          "quantity": {
            "value": 20,
            "unit": "percent_relative"
          },
          "property_binding": null,
          "metric": {
            "id": "scale_x",
            "definition": "Local X scale of the reference object"
          },
          "magnitude_basis": "example"
        }
      ],
      "constraints": [
        {
          "id": "preserve_yz",
          "description": "Local Y and Z scale, the camera, the rig pivot and the wing positions are preserved."
        }
      ],
      "acceptance": [
        {
          "status": "not_evaluated",
          "kind": "numeric",
          "metric_id": "scale_x",
          "operator": "approx",
          "value": 1.2,
          "unit": "factor",
          "tolerance": 1e-06
        },
        {
          "status": "not_evaluated",
          "kind": "human",
          "description": "Compare whether the original rounded body identity and the principal silhouette are preserved."
        }
      ],
      "execution": {
        "adapter": null,
        "binding_resolved": false,
        "authorized": false,
        "run_ref": null
      },
      "note": "The numbers and target names are a serialization example. They are not recommended thresholds, real assets, or verified results."
    },
    {
      "$schema": "instruction.v2.schema.json",
      "schema_version": "2.0.0",
      "id": "example.silhouette_gap",
      "status": "proposed",
      "axis": "direction_compliance",
      "intent": "Check the specified gap between body and wing at a low display resolution.",
      "target": {
        "asset_ref": "example://assets/drone-study",
        "selector": "Drone/BodyWingGap",
        "selector_language": "illustrative_scene_path"
      },
      "context": {
        "camera_ref": "example://cameras/gameplay",
        "image_ref": "example://renders/silhouette_pre_fx",
        "resolution": {
          "width": 320,
          "height": 180
        },
        "space": "screen_internal",
        "origin": "top_left",
        "axes": "x_right_y_down",
        "time": {
          "value": 0.8,
          "unit": "s"
        },
        "mask_definition": "binary object-ID silhouette; no bloom or AA",
        "measurement_scanline_y": 96,
        "roi": {
          "x": 138,
          "y": 96,
          "width": 44,
          "height": 1
        }
      },
      "changes": [
        {
          "term_id": "shape.notch",
          "operation": "define_metric",
          "quantity": {
            "value": 2,
            "unit": "px"
          },
          "metric": {
            "id": "gap_px",
            "definition": "The number of empty pixel columns between the right edge of Body and the left edge of Wing on the y=96 scanline of the ROI. Both edges must be present."
          },
          "property_binding": null,
          "magnitude_basis": "example"
        }
      ],
      "constraints": [
        {
          "id": "frame_fixed",
          "description": "The camera, internal resolution and pose are held; no claim is made to have measured every gap outside the defined ROI."
        }
      ],
      "acceptance": [
        {
          "status": "not_evaluated",
          "kind": "numeric",
          "metric_id": "gap_px",
          "operator": "gte",
          "value": 2,
          "unit": "px"
        },
        {
          "status": "not_evaluated",
          "kind": "human",
          "description": "Check whether that gap actually helps separate the targets. 2px is not a universal readability criterion for every screen."
        }
      ],
      "execution": {
        "adapter": null,
        "binding_resolved": false,
        "authorized": false,
        "run_ref": null
      },
      "note": "The numbers and target names are a serialization example. They are not recommended thresholds, real assets, or verified results."
    },
