      "operation": "set_sequence",
      "sequence": [
        "world_raster",
        "pixelated_world",
        "secondary_tint",
        "dithering",
        "nearest_upscale",
        "clean_ui_composite"
      ],
      "property_binding": null,
      "magnitude_basis": "none"
    },
    {
      "term_id": "pixel_sprite.selective_nonpixel",
      "operation": "set_relation",
      "relation": {
        "excluded_from_pixelation": [
          "clean_ui"
        ],
        "bloom_routing": "requires_separate_decision"
      },
      "property_binding": null,
      "magnitude_basis": "none"
    }
  ],
  "constraints": [
    {
      "id": "design_not_architecture",
      "description": "The stage names express intent. The concrete pass count, the position of bloom, and recovery of lighting information are not settled."
    }
  ],
  "acceptance": [
    {
      "status": "not_evaluated",
      "kind": "graph",
      "description": "Check that the stated precedence relations and the UI exclusion scope are met in the implementation graph."
    },
    {
      "status": "not_evaluated",
      "kind": "human",
      "description": "Check that the pixel grid, the dithering and the clean UI appear on the layers required."
    }
  ],
  "execution": {
    "adapter": null,
    "binding_resolved": false,
    "authorized": false,
    "run_ref": null
  },
  "note": "The numbers and target names are a serialization example. They are not recommended thresholds, real assets, or verified results."
