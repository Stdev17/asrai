{
  "$schema": "instruction.v2.schema.json",
  "schema_version": "2.0.0",
  "id": "example.compositing",
  "status": "proposed",
  "axis": "direction_compliance",
  "intent": "Record the ordering between pixelation, the added tint, dithering, and the clean UI.",
  "target": {
    "asset_ref": "example://assets/drone-study",
